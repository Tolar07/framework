# Auto detect text files and perform LF normalization
* text=auto

# Python files - always use LF
*.py text eol=lf

# Web files - always use LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Config files - always use LF
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf

# Markdown - always use LF
*.md text eol=lf

# Batch files - use CRLF on Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Append-only logs written by several workflows (daily NBA board, NBA line
# watch): keep both sides' lines on a merge/rebase instead of conflicting.
# A conflict here dropped the 7 Oct evening board's commit (2026-10-08).
output/nba_ladders/*.jsonl merge=union
# Same for every SportyBet NBA market at every look (engine/nba_markets.py): a
# conflict here dropped the 15 Oct evening board's commit, picks and all (2026-10-15).
output/nba_markets/*.jsonl merge=union
