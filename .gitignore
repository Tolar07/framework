# Secrets — never committed. Keys live here locally and as encrypted repo
# secrets in GitHub Actions (Settings -> Secrets and variables -> Actions).
.env
.env.*
.env.local
*.key
credentials.json
service_account.json
*.pem

# Session state / conversation logs / data dumps — contain live secrets
memory/conversations/
*.jsonl
!backtest/results/metrics_history.jsonl
!output/boards/feed_audit.jsonl
!feed_audit.jsonl

# Cached source data — re-fetchable, and large
data/cache/
backtest/cache/
backtest/results/*
# EXCEPTION (Phase 3.5): the metrics history IS tracked — it is the
# "metrics over time" record the backtest CI workflow commits back each run.
# The bulky report .txt and leg-log .json in results/ stay ignored.
!backtest/results/metrics_history.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Scratch
tests/tmp_*.json
*.tmp
# Rendered-output scratch captures (manual test artifacts, e.g. lean_reply.txt)
*_reply.txt

# Active process logs — always changing
logs/poller.log
logs/web.jsonl
logs/web_server.log

# Runtime state / data dumps — never commit
data/live_odds/
logs/*.log
logs/*.jsonl
clv/clv_log*.json
debrief/
config/league_groups.json
config/leagues.json
data/fs_leagues.json
data/fs_suggest.json
.claude/settings.local.json
memory/telegram_offset.json
monitoring/
output/league_coverage_state.json
acca_*.json
test_conversation.jsonl

# Brain database — derived, re-buildable from clv_log.json + model history
brain/*.db
brain/*.db-wal
brain/*.db-shm
sandbox/sandbox_log.json

# Web dashboard generated artifacts — regenerated every run / export
output/boards/*.json
# Published store — runtime state written by the /admin Approve→Publish action.
# Like the raw boards, it is regenerated per publish and must not be committed.
output/boards/published/
webapp/site/

# Club-crest cache — populated by webapp/crests.prefetch(), runtime state
webapp/crests_cache.json

# Webapp static scratch — one-off extraction/fetch helpers, not assets
webapp/static/_crit_tmp.txt
webapp/static/_fetch_fonts.py

# graphify — knowledge graph (regenerates via `graphify update .`, no API cost)
graphify-out/
