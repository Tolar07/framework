{
  "title": "OLP XDV Football Betting Calibration",
  "uid": "olp-xdv-dashboard",
  "tags": ["olp", "xdv", "betting", "paper"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Web Server Up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "olp_web_up",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Published Boards",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "olp_boards_published_total",
          "legendFormat": "boards",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {} }],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Phase-3 Gate: Legs Logged",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "olp_phase3_legs_logged_total",
          "legendFormat": "legs",
          "refId": "A"
        },
        {
          "expr": "olp_phase3_gate_requirement",
          "legendFormat": "requirement",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {} }],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "blue" }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Phase-3 Gate: Legs with CLV",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "olp_phase3_legs_with_clv_total",
          "legendFormat": "legs with CLV",
          "refId": "A"
        },
        {
          "expr": "olp_phase3_gate_requirement",
          "legendFormat": "requirement",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": {} }],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }] }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Phase-3 Gate: Mean CLV %",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "olp_phase3_mean_clv_pct",
          "legendFormat": "mean CLV %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": -5,
          "max": 5,
          "thresholds": { "mode": "absolute", "steps": [{ "value": -100, "color": "red" }, { "value": 0, "color": "yellow" }, { "value": 0.5, "color": "green" }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Gate Met (pending Architect sign-off)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "olp_phase3_gate_met_pending_architect_signoff",
          "legendFormat": "gate met",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NOT MET", "color": "red" }, "1": { "text": "MET ✓ (awaiting sign-off)", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Health State Severity (by component)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "olp_health_severity",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "gray" }, { "value": 1, "color": "green" }, { "value": 2, "color": "yellow" }, { "value": 3, "color": "red" }] },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "unknown" }, "1": { "text": "ok" }, "2": { "text": "warn" }, "3": { "text": "critical" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Last Run Age (seconds)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "olp_last_run_age_seconds",
          "legendFormat": "age",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }, { "value": 3600, "color": "yellow" }, { "value": 7200, "color": "red" }] },
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        }
      }
    },
    {
      "type": "stat",
      "title": "Process Uptime (minutes)",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "olp_process_uptime_seconds / 60",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "min",
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "green" }] }
        }
      }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}