# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these same names become encrypted repository secrets.

# Live odds for the MES entry price (the-odds-api.com, free tier ~500 req/month)
ODDS_API_KEY=

# Upcoming fixtures (thesportsdb.com). Leave blank to fall back to the shared
# public test key "123", which is rate-limited and truncates the league list.
THESPORTSDB_KEY=

# Daily board delivery (@BotFather -> /newbot). CHAT_ID is found by messaging
# the bot once, then reading getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: upcoming fixtures via API-Football (paid plans only see the
# current season; the free tier is capped at seasons 2022-2024).
API_FOOTBALL_KEY=
