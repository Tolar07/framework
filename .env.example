# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these same names become encrypted repository secrets.

# Live odds for the MES entry price (the-odds-api.com, free tier ~500 req/month)
ODDS_API_KEY=

# Upcoming fixtures (thesportsdb.com). Leave blank to fall back to the shared
# public test key "123", which is rate-limited and truncates the league list.
THESPORTSDB_KEY=

# Daily board delivery (@BotFather -> /newbot). CHAT_ID is found by messaging
# the bot once, then reading getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a separate Architect-only chat for the bet365 board (order 29).
TELEGRAM_OWNER_CHAT_ID=
# Subscribers (order 33): comma-separated chat ids that get everything except
# the bet365 board. In GitHub this must be a REPOSITORY secret.
TELEGRAM_SUBSCRIBER_CHAT_IDS=

# Optional: upcoming fixtures via API-Football (paid plans only see the
# current season; the free tier is capped at seasons 2022-2024).
API_FOOTBALL_KEY=

# --- Laptop line only (webapp/ is parked in legacy/laptop/; no live code reads
# ADMIN_USER, ADMIN_PASS, OLP_REQUIRE_ADMIN_AUTH or ARCHITECT_SIGNOFF). ---
# Admin dashboard (webapp/server.py /admin) — HTTP Basic auth on /admin,
# /stats, /why, /api/admin/* and POST /api/trigger-board.
ADMIN_USER=architect
ADMIN_PASS=

# Dev-only escape hatch: set OLP_REQUIRE_ADMIN_AUTH=0 to LIFT Basic auth so
# the prototype is easy to open. Default is ON — /admin exposes full model
# internals, so keep auth on for any phone-reachable / deployed host.
OLP_REQUIRE_ADMIN_AUTH=1

# Client publish — Architect override of the Phase 3 statistical gate.
# Set to 1 to publish boards to the client before the CLV gate is met;
# the override is never silent (stamped into publish_audit.jsonl).
# Set to 0 to re-block.
ARCHITECT_SIGNOFF=0

# Claude PR review (claude-review.yml) uses ANTHROPIC_API_KEY or
# CLAUDE_CODE_OAUTH_TOKEN as a GitHub secret. On the laptop line it was the
# webapp AI Analyst chat (/api/analyst). Requires the anthropic
# package (in requirements.txt) + this key. Leave blank to keep the panel
# honestly "unavailable" rather than degrade silently.
ANTHROPIC_API_KEY=
